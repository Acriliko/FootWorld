    <div class="logo-container">
        <img id="cup" src="<%= request.getContextPath() %>/logo/FootWorld.png" width="150" alt="FootWorld Logo">
    </div>
</header>

<nav class="nav-bar">
    <ul class="menu">
        <li><a href="<%= request.getContextPath() %>/common/home.jsp">HOME</a></li>
