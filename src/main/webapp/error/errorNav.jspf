        <li><a href="<%= request.getContextPath() %>/categorie/sneakers.jsp">SNEAKERS</a></li>
        <li><a href="<%= request.getContextPath() %>/categorie/abbigliamento.jsp">ABBIGLIAMENTO</a></li>
