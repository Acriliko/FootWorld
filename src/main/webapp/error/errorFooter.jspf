<%-- Footer per le pagine di errore (statico, con i link corretti rispetto alla cartella /error). --%>
<footer>
    <div class="footer-container">
        <div class="footer-section about">
            <h2>Chi siamo</h2>
            <p>Vieni a scoprirci in <br> Via Il Viale Del Negozio 10</p>
        </div>
        <div class="footer-section links">
            <h2>Link</h2>
            <ul>
                <li><a href="<%= request.getContextPath() %>/footerInfo/chiSiamo.jsp">Chi Siamo</a></li>
                <li><a href="<%= request.getContextPath() %>/footerInfo/servizi.jsp">Servizi</a></li>
                <li><a href="<%= request.getContextPath() %>/footerInfo/contatti.jsp">Contatti</a></li>
            </ul>
        </div>
        <div class="footer-section social">
            <h2>Follow Us</h2>
            <div class="social-icons">
                <a href="https://www.facebook.com/" target="_blank" rel="noopener"><i class='bx bxl-facebook'></i></a>
                <a href="https://x.com/" target="_blank" rel="noopener"><i class='bx bxl-twitter'></i></a>
                <a href="https://www.instagram.com/" target="_blank" rel="noopener"><i class='bx bxl-instagram'></i></a>
                <a href="https://it.linkedin.com/" target="_blank" rel="noopener"><i class='bx bxl-linkedin'></i></a>
            </div>
        </div>
    </div>
    <div class="footer-bottom">
        &copy; 2025 FootWorld. Tutti i diritti riservati.
    </div>
</footer>
